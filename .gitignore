# Documentation build
docs/_build/

# Hyperion model inputs and outputs, and the compendium tabulations themselves.
# These are large, reproducible from the configuration, and published to Zenodo
# rather than tracked here. Anchored to the repository root, so that package
# data such as src/dustcompendium/dust/data/ is not swept up with it.
/data/
*.hdf5
*.rtout
*.pbs
*.log

# An unpacked hyperion-dust source tree, which `dust-compendium grains` reads to
# build the standard grain files. It is third-party source, 60 MB of tabulated
# optical constants, and is fetched with `pip download hyperion-dust`.
/hyperion-dust-*/
/hyperion-dust-*.tar.gz

